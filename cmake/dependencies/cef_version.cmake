# Pinned CEF binary distribution. Used by cef.cmake at configure time and by cef_fetch.cmake in script mode.

set(NUI_CEF_PINNED_VERSION "154.0.34+g14c5a08+chromium-154.0.8037.98")
set(NUI_CEF_DOWNLOAD_BASE_URL "https://cef-builds.spotifycdn.com")

set(NUI_CEF_SHA256_linux64 "e87e2c76304372dd28b899ceb6efa4b353f52700594ddc358a8237ec07ec6492")
set(NUI_CEF_SHA256_linuxarm64 "4598b350e5a43519dbb9f1c732e8b184333572da53244ff55cc063003c34c5e4")
set(NUI_CEF_SHA256_macosarm64 "b7efb24bcce34b94e836a9f545005aea210e08abdf4ee1483ea03b8daf93f080")
set(NUI_CEF_SHA256_macosx64 "ebcb691252c9ccde63488a913e2381bce4e275acbbb96ce4763b318b7f0b781a")

# Oldest CEF API version the Nui sources compile against (see CEF_API_ADDED in the CEF headers).
set(NUI_CEF_API_VERSION_MIN 14100)

# Maps a system name and processor to the CEF platform name of the distribution archives.
function(nui_cef_platform_for systemName processor outVariable)
    string(TOLOWER "${processor}" processor)
    if (systemName STREQUAL "Linux")
        if (processor MATCHES "^(x86_64|amd64)$")
            set(platform linux64)
        elseif (processor MATCHES "^(aarch64|arm64)$")
            set(platform linuxarm64)
        endif()
    elseif (systemName STREQUAL "Darwin")
        if (processor MATCHES "^(arm64|aarch64)$")
            set(platform macosarm64)
        elseif (processor MATCHES "^(x86_64|amd64)$")
            set(platform macosx64)
        endif()
    endif()
    if (NOT platform)
        message(FATAL_ERROR "No CEF distribution for ${systemName}/${processor}, set NUI_CEF_PLATFORM or NUI_CEF_ROOT")
    endif()
    set(${outVariable} ${platform} PARENT_SCOPE)
endfunction()

function(nui_cef_archive_name platform outVariable)
    set(${outVariable} "cef_binary_${NUI_CEF_PINNED_VERSION}_${platform}_minimal.tar.bz2" PARENT_SCOPE)
endfunction()

function(nui_cef_default_download_directory outVariable)
    if (CMAKE_HOST_APPLE AND DEFINED ENV{HOME})
        set(directory "$ENV{HOME}/Library/Caches/nui/cef")
    elseif (DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
        set(directory "$ENV{XDG_CACHE_HOME}/nui/cef")
    elseif (DEFINED ENV{HOME})
        set(directory "$ENV{HOME}/.cache/nui/cef")
    else()
        set(directory "${CMAKE_BINARY_DIR}/_deps/cef-download")
    endif()
    set(${outVariable} "${directory}" PARENT_SCOPE)
endfunction()

# Downloads the pinned archive of a platform into a directory, verified with SHA256. Skips valid existing files.
function(nui_cef_download platform directory outArchive)
    set(sha256 "${NUI_CEF_SHA256_${platform}}")
    if (NOT sha256)
        message(FATAL_ERROR "No pinned SHA256 for CEF platform ${platform}")
    endif()
    nui_cef_archive_name(${platform} name)
    set(archive "${directory}/${name}")
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${directory}/${name}.lock" GUARD FUNCTION TIMEOUT 3600)
    if (EXISTS "${archive}")
        file(SHA256 "${archive}" existing)
        if (existing STREQUAL sha256)
            set(${outArchive} "${archive}" PARENT_SCOPE)
            return()
        endif()
        message(STATUS "${archive} does not match the pinned SHA256 ${sha256}, downloading it again")
        file(REMOVE "${archive}")
    endif()
    string(REPLACE "+" "%2B" encodedName "${name}")
    message(STATUS "Downloading ${NUI_CEF_DOWNLOAD_BASE_URL}/${encodedName}")
    file(DOWNLOAD "${NUI_CEF_DOWNLOAD_BASE_URL}/${encodedName}" "${archive}.part" STATUS status SHOW_PROGRESS)
    list(GET status 0 code)
    if (NOT code EQUAL 0)
        file(REMOVE "${archive}.part")
        message(FATAL_ERROR
            "Downloading the CEF distribution failed: ${status}. For offline builds set NUI_FETCH_CEF=OFF and pass "
            "NUI_CEF_ARCHIVE, NUI_CEF_ROOT or NUI_CEF_SYSTEM")
    endif()
    file(SHA256 "${archive}.part" downloaded)
    if (NOT downloaded STREQUAL sha256)
        file(REMOVE "${archive}.part")
        message(FATAL_ERROR "The downloaded CEF distribution has SHA256 ${downloaded}, expected ${sha256}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
    set(${outArchive} "${archive}" PARENT_SCOPE)
endfunction()

# Extracts an archive into <directory>/<archive name without extension>, once. Returns the distribution root.
function(nui_cef_extract archive directory outRoot)
    if (NOT archive OR NOT EXISTS "${archive}")
        message(FATAL_ERROR "The CEF archive '${archive}' does not exist")
    endif()
    get_filename_component(name "${archive}" NAME)
    string(REGEX REPLACE "\\.tar\\.(bz2|xz|gz)$" "" stem "${name}")
    set(root "${directory}/${stem}")
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${directory}/${stem}.lock" GUARD FUNCTION TIMEOUT 3600)
    if (NOT EXISTS "${root}/include/cef_version.h")
        message(STATUS "Extracting ${name}")
        set(temporary "${directory}/.extract-${stem}")
        file(REMOVE_RECURSE "${temporary}")
        file(MAKE_DIRECTORY "${temporary}")
        # In a child process, so a broken archive leaves no partly extracted tree behind.
        execute_process(
            COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
            WORKING_DIRECTORY "${temporary}"
            RESULT_VARIABLE result
            ERROR_VARIABLE errors)
        if (NOT result EQUAL 0)
            file(REMOVE_RECURSE "${temporary}")
            # The first line is the reason, the child adds its own "CMake Error" lines after it.
            string(REGEX MATCH "^[^\n]*" reason "${errors}")
            message(FATAL_ERROR "Extracting ${archive} failed: ${reason}")
        endif()
        file(GLOB extracted LIST_DIRECTORIES true "${temporary}/*")
        list(LENGTH extracted count)
        if (NOT count EQUAL 1)
            file(REMOVE_RECURSE "${temporary}")
            message(FATAL_ERROR "Unexpected layout of ${archive}")
        endif()
        file(REMOVE_RECURSE "${root}")
        file(RENAME "${extracted}" "${root}")
        file(REMOVE_RECURSE "${temporary}")
    endif()
    set(${outRoot} "${root}" PARENT_SCOPE)
endfunction()
